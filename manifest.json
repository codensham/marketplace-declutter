{
  "manifest_version": 3,
  "name": "Marketplace Declutter",
  "version": "0.4.0",
  "description": "Hides Facebook Marketplace listings that are outside your radius, shipping-only, or seller ads.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Marketplace Declutter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["lib/geo.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/places.json"],
      "matches": ["https://www.facebook.com/*"]
    }
  ]
}
